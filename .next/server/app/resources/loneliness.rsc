1a:{"metadata":[["$","title","0",{"children":"Loneliness: The Gap Between Contact and Connection — Mental Health Anonymous"}],["$","meta","1",{"name":"description","content":"Loneliness is a signal, like hunger. It responds less to more socialising than to a small number of interactions with real depth."}],["$","meta","2",{"name":"author","content":"Mental Health Anonymous Clinical Team"}],["$","meta","3",{"name":"keywords","content":"loneliness,isolation,connection,belonging,friendship,social"}],["$","meta","4",{"name":"robots","content":"index, follow"}],["$","meta","5",{"property":"og:title","content":"Mental Health Anonymous — Anonymous Resource Dispatch"}],["$","meta","6",{"property":"og:description","content":"Send a calm, shame-free educational guide to someone who needs it. Zero retention, no accounts, 100% confidential."}],["$","meta","7",{"property":"og:site_name","content":"Mental Health Anonymous"}],["$","meta","8",{"property":"og:locale","content":"en_US"}],["$","meta","9",{"property":"og:type","content":"website"}],["$","meta","10",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","11",{"name":"twitter:title","content":"Mental Health Anonymous — Anonymous Resource Dispatch"}],["$","meta","12",{"name":"twitter:description","content":"Send a calm, shame-free educational guide to someone who needs it. Zero retention, no accounts, 100% confidential."}]],"error":null,"digest":"$undefined"}
