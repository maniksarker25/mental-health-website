4-4"}],"$undefined"]}],["$","div",null,{"children":[["$","p",null,{"className":"text-[11px] font-semibold uppercase tracking-widest text-brand","children":"Fact"}],["$","p",null,{"className":"mt-1.5 text-sm leading-relaxed text-ink","children":"Avoidance teaches the brain the threat was real. Gradual, supported exposure is what lowers the alarm long term."}]]}]]}]]}],"$L2f"]}]}]]}]
24:["$","section",null,{"id":"coping","aria-labelledby":"coping-heading","className":"scroll-mt-24 border-t border-line pt-12","children":[["$","p",null,{"className":"text-sm font-medium text-brand","children":"Coping strategies"}],["$","h2",null,{"id":"coping-heading","className":"mt-3 max-w-2xl font-serif text-3xl leading-tight text-ink","children":"Evidence-based tools you can try today"}],["$","p",null,{"className":"mt-4 max-w-prose text-base leading-relaxed text-body","children":"Each of these is drawn from an established therapy protocol. Start with one and repeat it — a tool used badly twice beats a tool read about once."}],["$","div",null,{"className":"mt-8","children":["$","ol",null,{"className":"grid gap-5 lg:grid-cols-3","children":[["$","li","The 5-4-3-2-1 grounding scan",{"className":"flex h-full flex-col rounded-3xl border border-line bg-surface p-6","children":[["$","span",null,{"className":"font-serif text-2xl text-brand","children":"01"}],["$","h4",null,{"className":"mt-3 font-serif text-xl leading-snug text-ink","children":"The 5-4-3-2-1 grounding scan"}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-body","children":"Interrupts the spiral by handing your attention something concrete to do."}],["$","ul",null,{"className":"mt-5 space-y-2.5 border-t border-line pt-5","children":[["$","li","Name five things you can see, out loud or silently.",{"className":"flex gap-2.5 text-sm leading-relaxed text-body","children":[["$","span",null,{"aria-hidden":"true","className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"}],"Name five things you can see, out loud or silently."]}],["$","li","Name four things you can physically feel — fabric, chair, floor.",{"className":"flex gap-2.5 text-sm leading-relaxed text-body","children":[["$","span",null,{"aria-hidden":"true","className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"}],"Name four things you can physically feel — fabric, chair, floor."]}],["$","li","Name three things you can hear, sta