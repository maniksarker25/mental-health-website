16:{"metadata":[["$","title","0",{"children":"Anxiety & Panic: When Your Body Sounds a False Alarm — Mental Health Support"}],["$","meta","1",{"name":"description","content":"A panic attack is not a heart attack, and chronic worry is not a character flaw. Here is what your nervous system is actually doing, and what reliably calms it."}],["$","meta","2",{"name":"author","content":"Mental Health Support Clinical Team"}],["$","meta","3",{"name":"keywords","content":"anxiety,panic attack,worry,racing heart,avoidance,GAD"}],["$","meta","4",{"name":"robots","content":"index, follow"}],["$","meta","5",{"property":"og:title","content":"Anxiety & Panic: When Your Body Sounds a False Alarm"}],["$","meta","6",{"property":"og:description","content":"Understanding the physical machinery of fear — and how to turn the volume down."}],["$","meta","7",{"property":"og:image","content":"https://mentalhealthsupport.app/6f1a0d9f-8579-46cc-ac9d-c99dc170b4df.jpg"}],["$","meta","8",{"property":"og:image:alt","content":"Anxiety & Panic: When Your Body Sounds a False Alarm"}],["$","meta","9",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","10",{"name":"twitter:title","content":"Mental Health Support — Anonymous Resource Dispatch"}],["$","meta","11",{"name":"twitter:description","content":"Send a calm, shame-free educational guide to someone who needs it. Zero retention, no accounts, 100% confidential."}],["$","meta","12",{"name":"twitter:image","content":"https://mentalhealthsupport.app/6f1a0d9f-8579-46cc-ac9d-c99dc170b4df.jpg"}],["$","meta","13",{"name":"twitter:image:alt","content":"Anxiety & Panic: When Your Body Sounds a False Alarm"}]],"error":null,"digest":"$undefined"}
