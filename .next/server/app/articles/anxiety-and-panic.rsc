1c:I[4853,["619","static/chunks/619-ba102abea3e3d0e4.js","195","static/chunks/195-a992a5a448a9c53e.js","381","static/chunks/381-89b8dbb4f4f3d951.js","406","static/chunks/app/articles/%5Bid%5D/page-30a43f43bd3b3899.js"],"ArticleHero"]
12:["$","article",null,{"children":[["$","$L1c",null,{"topic":{"id":"anxiety-and-panic","title":"Anxiety & Panic: When Your Body Sounds a False Alarm","subtitle":"Understanding the physical machinery of fear — and how to turn the volume down.","category":"Anxiety & Panic","tone":"sky","icon":"wind","keywords":["anxiety","panic attack","worry","racing heart","avoidance","GAD"],"readingTime":9,"featuredImage":"/6f1a0d9f-8579-46cc-ac9d-c99dc170b4df.jpg","excerpt":"A panic attack is not a heart attack, and chronic worry is not a character flaw. Here is what your nervous system is actually doing, and what reliably calms it.","reviewer":"Reviewed by Dr. Sarah Jenkins, PsyD","updated":"Updated August 2026","intro":["Anxiety is the body preparing for a threat that has not arrived. That preparation is not imaginary — the heart really does beat faster, the chest really does tighten, thinking really does narrow. What is inaccurate is the size of the threat, not the sensation.","Roughly one in five adults lives with an anxiety condition in any given year. It is the most common and most treatable group of mental health conditions, and most people improve substantially with 8–16 weeks of structured therapy."],"mechanics":{"heading":"What is happening in your body","body":["The amygdala flags something as dangerous and triggers a surge of adrenaline before the thinking brain has weighed in. Blood is redirected to large muscles, breathing quickens to load oxygen, and digestion slows. This is why anxiety so often shows up as nausea, cold hands, or a racing pulse.","A panic attack is that surge at full volume. It peaks around ten minutes and cannot physically sustain itself — the body runs out of adrenaline. Knowing the ceiling exists is itself a form of relief: the sensation is intense, self-limiting, and not dangerous."]},"symptoms":[{"label":"Racing or pounding heart","description":"Often the first thing noticed, and frequently mistaken for a cardiac event.","kind":"Body"},{"label":"Shallow chest breathing","description":"Rapid upper-chest breaths that create light-headedness and tingling fingers.","kind":"Body"},{"label":"Catastrophic forecasting","description":"The mind jumps to the worst outcome and treats it as the likely one.","kind":"Mind"},{"label":"Quiet avoidance","description":"Declining plans, delaying calls, or leaving early — relief now, more fear later.","kind":"Behavior"}],"myths":[{"myth":"Panic attacks mean something is medically wrong with your heart.","fact":"Once a clinician has ruled out cardiac causes, panic symptoms are a stress response — uncomfortable and not physically harmful."},{"myth":"If I avoid what scares me, the anxiety will fade.","fact":"Avoidance teaches the brain the threat was real. Gradual, supported exposure is what lowers the alarm long term."},{"myth":"Anxious people just need to relax more.","fact":"Relaxation helps in the moment but does not retrain threat prediction. That takes structured practice, and often therapy."}],"strategies":[{"name":"The 5-4-3-2-1 grounding scan","summary":"Interrupts the spiral by handing your attention something concrete to do.","steps":["Name five things you can see, out loud or silently.","Name four things you can physically feel — fabric, chair, floor.","Name three things you can hear, starting with the furthest away.","Name two things you can smell, then one thing you can taste."]},{"name":"Extended exhale breathing","summary":"A longer exhale activates the vagus nerve and lowers heart rate within a minute or two.","steps":["Breathe in through the nose for a count of four.","Hold gently for seven — no straining.","Exhale through the mouth for eight, as if fogging a window.","Repeat four cycles, then check in with your body."]},{"name":"Scheduled worry window","summary":"Contains rumination instead of fighting it, which frees the rest of the day.","steps":["Pick the same 15 minutes each day, not close to bedtime.","When a worry arrives outside the window, write one line and defer it.","In the window, write each worry and one next action — or mark it unsolvable.","Close the notebook when time is up, even mid-thought."]}],"treatments":[{"name":"Cognitive Behavioural Therapy","abbreviation":"CBT","description":"The best-evidenced treatment for anxiety. Identifies the thought–feeling–behaviour loop and rebuilds it with gradual exposure."},{"name":"Acceptance & Commitment Therapy","abbreviation":"ACT","description":"Reduces the struggle against anxious sensations and reorients daily choices around values rather than fear."},{"name":"Medical consultation","abbreviation":"MD","description":"A physician can rule out thyroid, cardiac, and medication causes, and discuss SSRIs or short-term options where appropriate."}],"support":{"guidance":"You do not need to argue someone out of anxiety. Your job is to be a steady, unhurried presence — slow your own speech, stay physically near, and let the peak pass without adding pressure.","say":["“I am here. We can just sit until this passes.”","“Nothing you feel right now needs explaining to me.”","“Do you want company, quiet, or some air?”"],"avoid":["“Calm down — there is nothing to worry about.”","“Just stop thinking about it.”","“Other people have it much worse.”"]},"faqs":[{"question":"Is medication a last resort?","answer":"No. Medication is one legitimate option among several, often used alongside therapy. The decision belongs to you and a prescribing clinician, not to a hierarchy of willpower."},{"question":"How long until therapy helps?","answer":"Most people notice a measurable shift in 6–8 sessions of CBT, with larger gains by 12–16. Progress is usually gradual rather than a single breakthrough."},{"question":"Will this website tell anyone I read it?","answer":"No. We store nothing about you — no account, no IP log, no analytics. Reading this page leaves no trace on our side."}],"pacer":[{"label":"4-7-8 calming","inhale":4,"hold":7,"exhale":8,"description":"The default. Longest exhale, strongest downshift — best for acute spikes."},{"label":"Box breathing","inhale":4,"hold":4,"exhale":4,"description":"Even and steady. Easier to hold for longer stretches before a stressful event."}]}}],"$L1d","$L1e"]}]
