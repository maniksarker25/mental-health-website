16:{"metadata":[["$","title","0",{"children":"OCD: The Trap of Certainty — Mental Health Support"}],["$","meta","1",{"name":"description","content":"OCD is not tidiness. It is a cycle of intrusive doubt and relief-seeking, and it responds to a specific, well-evidenced therapy."}],["$","meta","2",{"name":"author","content":"Mental Health Support Clinical Team"}],["$","meta","3",{"name":"keywords","content":"OCD,obsessions,compulsions,intrusive thoughts,ERP,checking"}],["$","meta","4",{"name":"robots","content":"index, follow"}],["$","meta","5",{"property":"og:title","content":"OCD: The Trap of Certainty"}],["$","meta","6",{"property":"og:description","content":"Compulsions work briefly, which is exactly why the doubt keeps returning."}],["$","meta","7",{"property":"og:image","content":"https://mentalhealthsupport.app/3014125d-fa77-4475-ad19-6fa3c021102a.jpg"}],["$","meta","8",{"property":"og:image:alt","content":"OCD: The Trap of Certainty"}],["$","meta","9",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","10",{"name":"twitter:title","content":"Mental Health Support — Anonymous Resource Dispatch"}],["$","meta","11",{"name":"twitter:description","content":"Send a calm, shame-free educational guide to someone who needs it. Zero retention, no accounts, 100% confidential."}],["$","meta","12",{"name":"twitter:image","content":"https://mentalhealthsupport.app/3014125d-fa77-4475-ad19-6fa3c021102a.jpg"}],["$","meta","13",{"name":"twitter:image:alt","content":"OCD: The Trap of Certainty"}]],"error":null,"digest":"$undefined"}
