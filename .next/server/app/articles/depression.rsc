16:{"metadata":[["$","title","0",{"children":"Depression: When the Volume of Everything Drops — Mental Health Support"}],["$","meta","1",{"name":"description","content":"Depression is not sadness turned up. It is a flattening of reward, energy, and self-narrative — and it responds to action taken before the motivation returns."}],["$","meta","2",{"name":"author","content":"Mental Health Support Clinical Team"}],["$","meta","3",{"name":"keywords","content":"depression,low mood,anhedonia,motivation,hopelessness,MDD"}],["$","meta","4",{"name":"robots","content":"index, follow"}],["$","meta","5",{"property":"og:title","content":"Depression: When the Volume of Everything Drops"}],["$","meta","6",{"property":"og:description","content":"Why motivation disappears before mood recovers, and how to work with that order."}],["$","meta","7",{"property":"og:image","content":"https://mentalhealthsupport.app/bbd80de0-72e7-4a34-bead-99f81d08bcba.jpg"}],["$","meta","8",{"property":"og:image:alt","content":"Depression: When the Volume of Everything Drops"}],["$","meta","9",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","10",{"name":"twitter:title","content":"Mental Health Support — Anonymous Resource Dispatch"}],["$","meta","11",{"name":"twitter:description","content":"Send a calm, shame-free educational guide to someone who needs it. Zero retention, no accounts, 100% confidential."}],["$","meta","12",{"name":"twitter:image","content":"https://mentalhealthsupport.app/bbd80de0-72e7-4a34-bead-99f81d08bcba.jpg"}],["$","meta","13",{"name":"twitter:image:alt","content":"Depression: When the Volume of Everything Drops"}]],"error":null,"digest":"$undefined"}
