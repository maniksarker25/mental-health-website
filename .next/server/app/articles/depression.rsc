1c:I[4853,["619","static/chunks/619-ba102abea3e3d0e4.js","195","static/chunks/195-a992a5a448a9c53e.js","381","static/chunks/381-89b8dbb4f4f3d951.js","406","static/chunks/app/articles/%5Bid%5D/page-30a43f43bd3b3899.js"],"ArticleHero"]
12:["$","article",null,{"children":[["$","$L1c",null,{"topic":{"id":"depression","title":"Depression: When the Volume of Everything Drops","subtitle":"Why motivation disappears before mood recovers, and how to work with that order.","category":"Depression","tone":"lavender","icon":"cloudRain","keywords":["depression","low mood","anhedonia","motivation","hopelessness","MDD"],"readingTime":8,"featuredImage":"/bbd80de0-72e7-4a34-bead-99f81d08bcba.jpg","excerpt":"Depression is not sadness turned up. It is a flattening of reward, energy, and self-narrative — and it responds to action taken before the motivation returns.","reviewer":"Reviewed by Dr. Priya Raman, PhD","updated":"Updated August 2026","intro":["People often expect depression to feel like crying. More often it feels like nothing: food without taste, music without pull, a to-do list that may as well be in another language.","That absence is a symptom, not a personality. Depression narrows the brain’s reward signalling, so activities that used to pay off no longer register — which makes withdrawal feel rational and deepens the loop."],"mechanics":{"heading":"Why willpower is the wrong lever","body":["In depression, the anticipation of reward dims before the capacity for it does. You can still enjoy a walk; you simply cannot feel in advance that you would. Waiting to feel like it means waiting for the last symptom to lift first.","This is why behavioural activation works: small scheduled actions taken without motivation slowly restore the reward signal. Mood follows movement rather than leading it."]},"symptoms":[{"label":"Loss of interest","description":"Things that reliably mattered — people, work, food — go flat. Clinicians call this anhedonia.","kind":"Mind"},{"label":"Leaden fatigue","description":"Sleep does not restore. Ordinary tasks cost several times their usual energy.","kind":"Body"},{"label":"Harsh self-narration","description":"A running commentary of burden, failure, and worthlessness that feels factual.","kind":"Mind"},{"label":"Withdrawal from contact","description":"Cancelling, leaving messages unread, shrinking the day down to survival.","kind":"Behavior"}],"myths":[{"myth":"Depression is caused by a simple chemical imbalance.","fact":"It involves biology, stress, sleep, circumstance, and thought patterns together. Treatment works on several of those at once."},{"myth":"If you can work and smile, it is not real depression.","fact":"High-functioning depression is common. Capability at work says nothing about internal cost."},{"myth":"You have to want to get better first.","fact":"Ambivalence is a symptom. Treatment can begin while hope is still absent."}],"strategies":[{"name":"Behavioural activation ladder","summary":"Builds momentum from actions small enough to be undeniable.","steps":["List activities that used to matter, ranked by effort.","Schedule the two easiest at fixed times tomorrow.","Do them at the scheduled time regardless of mood.","Rate mood before and after — collect evidence, not opinions."]},{"name":"The two-minute floor","summary":"Removes the negotiation about whether today is a good enough day.","steps":["Choose one anchor task: teeth, shower, one glass of water, one open window.","Commit to two minutes, with permission to stop after.","Do it at the same time daily so it stops requiring a decision."]},{"name":"Thought-record reframing","summary":"Separates a feeling from a verdict about who you are.","steps":["Write the thought verbatim, including the cruelty.","Note the evidence for it, then the evidence against it.","Write a version you would say to someone you respect."]}],"treatments":[{"name":"Cognitive Behavioural Therapy","abbreviation":"CBT","description":"Targets the thought patterns and withdrawal that maintain low mood; strongest evidence base for mild to moderate depression."},{"name":"Behavioural Activation","abbreviation":"BA","description":"A focused, structured therapy that rebuilds daily activity and reward. Often effective when energy is the main barrier."},{"name":"Medication review","abbreviation":"MD","description":"Antidepressants can help moderate to severe depression, usually within 4–6 weeks. A prescriber should also check thyroid, iron, and vitamin D."}],"support":{"guidance":"Offer specific, low-effort presence rather than open-ended invitations. “Let me know if you need anything” asks a depressed person to do the organising. Bring the plan with you.","say":["“I am bringing dinner Thursday at seven. You do not have to talk.”","“You are not a burden to me. I am choosing to be here.”","“Would it help if I made the appointment call with you?”"],"avoid":["“You have so much to be grateful for.”","“Have you tried exercising more?”","“Snap out of it — this isn’t you.”"]},"faqs":[{"question":"Should I push someone to socialise?","answer":"Invite gently and repeatedly without penalty for declining. Pressure adds guilt; a standing, no-obligation invitation keeps the door open."},{"question":"When is it urgent?","answer":"If someone mentions wanting to die, giving possessions away, or has a plan, treat it as urgent. Stay with them and call or text 988 together."},{"question":"Can depression lift on its own?","answer":"Some episodes remit without treatment, but untreated episodes tend to be longer and more likely to recur. Treatment shortens and softens them."}],"pacer":[{"label":"Gentle 4-4-6","inhale":4,"hold":4,"exhale":6,"description":"A low-effort pace for days when even breathing exercises feel like work."},{"label":"4-7-8 calming","inhale":4,"hold":7,"exhale":8,"description":"Use when low mood arrives with agitation or a tight chest."}]}}],"$L1d","$L1e"]}]
