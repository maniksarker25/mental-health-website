"]}],["$","div",null,{"children":[["$","p",null,{"className":"text-[11px] font-semibold uppercase tracking-widest text-brand","children":"Fact"}],["$","p",null,{"className":"mt-1.5 text-sm leading-relaxed text-ink","children":"High-functioning depression is common. Capability at work says nothing about internal cost."}]]}]]}]]}],["$","li","You have to want to get better first.",{"className":"grid gap-0 overflow-hidden rounded-3xl border border-line md:grid-cols-2","children":["$L2f","$L30"]}]]}]}]]}]
24:["$","section",null,{"id":"coping","aria-labelledby":"coping-heading","className":"scroll-mt-24 border-t border-line pt-12","children":[["$","p",null,{"className":"text-sm font-medium text-brand","children":"Coping strategies"}],["$","h2",null,{"id":"coping-heading","className":"mt-3 max-w-2xl font-serif text-3xl leading-tight text-ink","children":"Evidence-based tools you can try today"}],["$","p",null,{"className":"mt-4 max-w-prose text-base leading-relaxed text-body","children":"Each of these is drawn from an established therapy protocol. Start with one and repeat it — a tool used badly twice beats a tool read about once."}],["$","div",null,{"className":"mt-8","children":["$","ol",null,{"className":"grid gap-5 lg:grid-cols-3","children":[["$","li","Behavioural activation ladder",{"className":"flex h-full flex-col rounded-3xl border border-line bg-surface p-6","children":[["$","span",null,{"className":"font-serif text-2xl text-brand","children":"01"}],["$","h4",null,{"className":"mt-3 font-serif text-xl leading-snug text-ink","children":"Behavioural activation ladder"}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-body","children":"Builds momentum from actions small enough to be undeniable."}],["$","ul",null,{"className":"mt-5 space-y-2.5 border-t border-line pt-5","children":[["$","li","List activities that used to matter, ranked by effort.",{"className":"flex gap-2.5 text-sm leading-relaxed text-body","children":[["$","span",null,{"aria-hidden":"true","className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"}],"List activities that used to matter, ranked by effort."]}],["$","li","Schedule the two easiest at fixed times tomorrow.",{"className":"flex gap-2.5 text-sm leading-relaxed text-body","children":[["$","span",null,{"aria-hidden":"true","className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"}],"Schedule the two easiest at fixed times tomorrow."]}],["$","li","Do them at the scheduled time regardless of mood.",{"className":"flex gap-2.5 text-sm leading-relaxed text-body","children":[["$","span",null,{"aria-hidden":"true","className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"}],"Do them at the scheduled time regardless of mood."]}],["$","li","Rate mood before and after — collect evidence, not opinions.",{"className":"flex gap-2.5 text-sm leading-relaxed text-body","children":[["$","span",null,{"aria-hidden":"true","className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"}],"Rate mood before and after — collect evidence, not opinions."]}]]}]]}],["$","li","The two-minute floor",{"className":"flex h-full flex-col rounded-3xl border border-line bg-surface p-6","children":[["$","span",null,{"className":"font-serif text-2xl text-brand","children":"02"}],["$","h4",null,{"className":"mt-3 font-serif text-xl leading-snug text-ink","children":"The two-minute floor"}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-body","children":"Removes the negotiation about whether today is a good enough day."}],["$","ul",null,{"className":"mt-5 space-y-2.5 border-t border-line pt-5","children":[["$","li","Choose one anchor task: teeth, shower, one glass of water, one open window.",{"className":"flex gap-2.5 text-sm leading-relaxed text-body","children":[["$","span",null,{"aria-hidden":"true","className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"}],"Choose one anchor task: teeth, shower, one glass of water, one open window."]}],["$","li","Commit to two minutes, with permission to stop after.",{"className":"flex gap-2.5 text-sm leading-relaxed text-body","children":[["$","span",null,{"aria-hidden":"true","className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"}],"Commit to two minutes, with permission to stop after."]}],["$","li","Do it at the same time daily so it stops requiring a decision.",{"className":"flex gap-2.5 text-sm leading-relaxed text-body","children":["$L31","Do it at the same time daily so it stops requiring a decision."]}]]}]]}],"$L32"]}]}]]}]
