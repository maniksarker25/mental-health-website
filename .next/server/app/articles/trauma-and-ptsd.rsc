16:{"metadata":[["$","title","0",{"children":"Trauma & PTSD: When the Past Keeps Arriving in the Present — Mental Health Support"}],["$","meta","1",{"name":"description","content":"Trauma is stored differently from ordinary memory, which is why it returns as sensation rather than story. Grounding and trauma-focused therapy both work with that."}],["$","meta","2",{"name":"author","content":"Mental Health Support Clinical Team"}],["$","meta","3",{"name":"keywords","content":"trauma,PTSD,flashback,hypervigilance,triggers,EMDR"}],["$","meta","4",{"name":"robots","content":"index, follow"}],["$","meta","5",{"property":"og:title","content":"Trauma & PTSD: When the Past Keeps Arriving in the Present"}],["$","meta","6",{"property":"og:description","content":"Flashbacks, hypervigilance, and numbing are protection, not malfunction."}],["$","meta","7",{"property":"og:image","content":"https://mentalhealthsupport.app/ff47f82f-c7ed-4863-b7ca-fd3bac014a4a.jpg"}],["$","meta","8",{"property":"og:image:alt","content":"Trauma & PTSD: When the Past Keeps Arriving in the Present"}],["$","meta","9",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","10",{"name":"twitter:title","content":"Mental Health Support — Anonymous Resource Dispatch"}],["$","meta","11",{"name":"twitter:description","content":"Send a calm, shame-free educational guide to someone who needs it. Zero retention, no accounts, 100% confidential."}],["$","meta","12",{"name":"twitter:image","content":"https://mentalhealthsupport.app/ff47f82f-c7ed-4863-b7ca-fd3bac014a4a.jpg"}],["$","meta","13",{"name":"twitter:image:alt","content":"Trauma & PTSD: When the Past Keeps Arriving in the Present"}]],"error":null,"digest":"$undefined"}
