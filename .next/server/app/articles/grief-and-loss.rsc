16:{"metadata":[["$","title","0",{"children":"Grief & Loss: Carrying What Cannot Be Fixed — Mental Health Support"}],["$","meta","1",{"name":"description","content":"The five stages were never meant as a sequence. Modern grief care focuses on oscillation — moving between loss and life — rather than on reaching acceptance."}],["$","meta","2",{"name":"author","content":"Mental Health Support Clinical Team"}],["$","meta","3",{"name":"keywords","content":"grief,bereavement,loss,mourning,anniversary,death"}],["$","meta","4",{"name":"robots","content":"index, follow"}],["$","meta","5",{"property":"og:title","content":"Grief & Loss: Carrying What Cannot Be Fixed"}],["$","meta","6",{"property":"og:description","content":"Grief is not a staircase you climb. It is weather you learn to live inside."}],["$","meta","7",{"property":"og:image","content":"https://mentalhealthsupport.app/89ea5304-a8bb-41e5-9dea-1e2b10aaa20c.jpg"}],["$","meta","8",{"property":"og:image:alt","content":"Grief & Loss: Carrying What Cannot Be Fixed"}],["$","meta","9",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","10",{"name":"twitter:title","content":"Mental Health Support — Anonymous Resource Dispatch"}],["$","meta","11",{"name":"twitter:description","content":"Send a calm, shame-free educational guide to someone who needs it. Zero retention, no accounts, 100% confidential."}],["$","meta","12",{"name":"twitter:image","content":"https://mentalhealthsupport.app/89ea5304-a8bb-41e5-9dea-1e2b10aaa20c.jpg"}],["$","meta","13",{"name":"twitter:image:alt","content":"Grief & Loss: Carrying What Cannot Be Fixed"}]],"error":null,"digest":"$undefined"}
