16:{"metadata":[["$","title","0",{"children":"Loneliness: The Gap Between Contact and Connection — Mental Health Support"}],["$","meta","1",{"name":"description","content":"Loneliness is a signal, like hunger. It responds less to more socialising than to a small number of interactions with real depth."}],["$","meta","2",{"name":"author","content":"Mental Health Support Clinical Team"}],["$","meta","3",{"name":"keywords","content":"loneliness,isolation,connection,belonging,friendship,social"}],["$","meta","4",{"name":"robots","content":"index, follow"}],["$","meta","5",{"property":"og:title","content":"Loneliness: The Gap Between Contact and Connection"}],["$","meta","6",{"property":"og:description","content":"You can be surrounded by people and still unmet. That gap is measurable — and closable."}],["$","meta","7",{"property":"og:image","content":"https://mentalhealthsupport.app/24be4b57-e071-4f09-9726-22df0281e8d1.jpg"}],["$","meta","8",{"property":"og:image:alt","content":"Loneliness: The Gap Between Contact and Connection"}],["$","meta","9",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","10",{"name":"twitter:title","content":"Mental Health Support — Anonymous Resource Dispatch"}],["$","meta","11",{"name":"twitter:description","content":"Send a calm, shame-free educational guide to someone who needs it. Zero retention, no accounts, 100% confidential."}],["$","meta","12",{"name":"twitter:image","content":"https://mentalhealthsupport.app/24be4b57-e071-4f09-9726-22df0281e8d1.jpg"}],["$","meta","13",{"name":"twitter:image:alt","content":"Loneliness: The Gap Between Contact and Connection"}]],"error":null,"digest":"$undefined"}
