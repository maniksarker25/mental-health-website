16:{"metadata":[["$","title","0",{"children":"Substance Use: Beyond Willpower and Rock Bottom — Mental Health Support"}],["$","meta","1",{"name":"description","content":"Substance use disorders are treatable medical conditions. Confrontation and ultimatums predict worse outcomes than curiosity and access to care."}],["$","meta","2",{"name":"author","content":"Mental Health Support Clinical Team"}],["$","meta","3",{"name":"keywords","content":"substance use,alcohol,addiction,recovery,relapse,harm reduction"}],["$","meta","4",{"name":"robots","content":"index, follow"}],["$","meta","5",{"property":"og:title","content":"Substance Use: Beyond Willpower and Rock Bottom"}],["$","meta","6",{"property":"og:description","content":"Change rarely begins with a dramatic moment. It begins with ambivalence taken seriously."}],["$","meta","7",{"property":"og:image","content":"https://mentalhealthsupport.app/2c24f0fa-868a-4068-8e48-996bef5a7078.jpg"}],["$","meta","8",{"property":"og:image:alt","content":"Substance Use: Beyond Willpower and Rock Bottom"}],["$","meta","9",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","10",{"name":"twitter:title","content":"Mental Health Support — Anonymous Resource Dispatch"}],["$","meta","11",{"name":"twitter:description","content":"Send a calm, shame-free educational guide to someone who needs it. Zero retention, no accounts, 100% confidential."}],["$","meta","12",{"name":"twitter:image","content":"https://mentalhealthsupport.app/2c24f0fa-868a-4068-8e48-996bef5a7078.jpg"}],["$","meta","13",{"name":"twitter:image:alt","content":"Substance Use: Beyond Willpower and Rock Bottom"}]],"error":null,"digest":"$undefined"}
