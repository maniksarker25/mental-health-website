16:{"metadata":[["$","title","0",{"children":"Burnout & Chronic Stress: The Cost of Running Without Recovery — Mental Health Support"}],["$","meta","1",{"name":"description","content":"Burnout is an occupational condition with three measurable dimensions. Rest alone will not fix it — the demands and the recovery both have to change."}],["$","meta","2",{"name":"author","content":"Mental Health Support Clinical Team"}],["$","meta","3",{"name":"keywords","content":"burnout,stress,overwork,exhaustion,boundaries,cynicism"}],["$","meta","4",{"name":"robots","content":"index, follow"}],["$","meta","5",{"property":"og:title","content":"Burnout & Chronic Stress: The Cost of Running Without Recovery"}],["$","meta","6",{"property":"og:description","content":"Exhaustion, cynicism, and dwindling effectiveness — and how to reverse them."}],["$","meta","7",{"property":"og:image","content":"https://mentalhealthsupport.app/bc248231-c940-4e95-a939-9f1a54a31f7a.jpg"}],["$","meta","8",{"property":"og:image:alt","content":"Burnout & Chronic Stress: The Cost of Running Without Recovery"}],["$","meta","9",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","10",{"name":"twitter:title","content":"Mental Health Support — Anonymous Resource Dispatch"}],["$","meta","11",{"name":"twitter:description","content":"Send a calm, shame-free educational guide to someone who needs it. Zero retention, no accounts, 100% confidential."}],["$","meta","12",{"name":"twitter:image","content":"https://mentalhealthsupport.app/bc248231-c940-4e95-a939-9f1a54a31f7a.jpg"}],["$","meta","13",{"name":"twitter:image:alt","content":"Burnout & Chronic Stress: The Cost of Running Without Recovery"}]],"error":null,"digest":"$undefined"}
