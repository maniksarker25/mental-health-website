 Sounds a False Alarm"}]}],["$","p",null,{"className":"mt-2.5 text-sm leading-relaxed text-body","children":"A panic attack is not a heart attack, and chronic worry is not a character flaw. Here is what your nervous system is actually doing, and what reliably calms it."}],["$","div",null,{"className":"mt-auto pt-6","children":["$","div",null,{"className":"flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-line pt-4 text-xs text-body","children":[["$","span",null,{"className":"inline-flex items-center gap-1.5","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-clock h-3.5 w-3.5","aria-hidden":"true","children":[["$","circle","1mglay",{"cx":"12","cy":"12","r":"10"}],["$","polyline","68esgv",{"points":"12 6 12 12 16 14"}],"$undefined"]}],9," min read"]}],["$","span",null,{"className":"inline-flex items-center gap-1.5","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-layers h-3.5 w-3.5","aria-hidden":"true","children":[["$","path","zw3jo",{"d":"M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"}],["$","path","1wduqc",{"d":"M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"}],["$","path","kqbvx6",{"d":"M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"}],"$undefined"]}],11," sections"]}],["$","$L6",null,{"href":"/articles/anxiety-and-panic","className":"ml-auto inline-flex items-center gap-1.5 font-medium text-brand transition-colors duration-150 ease-gentle hover:text-ink","children":["Read guide",["$","svg",null,{"ref":"$undefined","xmlns":"ht